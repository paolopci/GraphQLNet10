@model EmployeeManagementGraphQL.Mvc.Models.ReviewsIndexVm
@{
    ViewData["Title"] = "Elenco Review";
}

<h1 class="mb-3">Elenco Review (Demo GraphQL)</h1>

<div class="mb-3 d-flex gap-2">
    <a class="btn btn-primary"
       asp-controller="Reviews"
       asp-action="Create"
       asp-route-employeeId="@Model.EmployeeId">Add Review</a>
    <a class="btn btn-outline-secondary"
       asp-controller="Reviews"
       asp-action="Index">Tutte le Review</a>
    <a class="btn btn-outline-secondary"
       asp-controller="Employees"
       asp-action="Index">Vai ai Dipendenti</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <strong>Errore:</strong> @Model.ErrorMessage
    </div>
}

<form method="get" asp-controller="Reviews" asp-action="Index" class="row g-3 mb-4">
    <div class="col-md-3">
        <label class="form-label" for="employeeId">EmployeeId</label>
        <input class="form-control"
               type="number"
               id="employeeId"
               name="employeeId"
               min="1"
               value="@(Model.EmployeeId?.ToString() ?? string.Empty)"
               placeholder="es. 1" />
    </div>
    <div class="col-md-9 d-flex align-items-end gap-2">
        <button type="submit" class="btn btn-primary">Applica filtro</button>
        <a class="btn btn-secondary" asp-controller="Reviews" asp-action="Index">Reset</a>
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info" role="alert">
        @(Model.EmployeeId.HasValue ? "Nessun Reviews collegati" : "Nessuna review disponibile")
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Id</th>
                    <th>Rate</th>
                    <th>Comment</th>
                    <th>EmployeeId</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var review in Model.Items)
                {
                    <tr>
                        <td>@review.Id</td>
                        <td>@review.Rate</td>
                        <td>@review.Comment</td>
                        <td>@review.EmployeeId</td>
                        <td>
                            <div class="d-flex gap-2">
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-controller="Reviews"
                                   asp-action="Edit"
                                   asp-route-id="@review.Id"
                                   asp-route-employeeId="@review.EmployeeId">Edit</a>
                                <a class="btn btn-sm btn-outline-danger"
                                   asp-controller="Reviews"
                                   asp-action="Delete"
                                   asp-route-id="@review.Id"
                                   asp-route-employeeId="@review.EmployeeId">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
