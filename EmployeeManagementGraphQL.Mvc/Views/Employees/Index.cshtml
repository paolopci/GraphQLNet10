@model EmployeeManagementGraphQL.Mvc.Models.EmployeesIndexVm
@{
    ViewData["Title"] = "Elenco Dipendenti";
    var currentPage = Model.PageInfo.Page;
    var totalPages = Model.PageInfo.TotalPages;
    var windowSize = 1;
    var startPage = Math.Max(1, currentPage - windowSize);
    var endPage = Math.Min(totalPages, currentPage + windowSize);

    string ToggleSortDir(string field)
    {
        return Model.SortField.Equals(field, StringComparison.OrdinalIgnoreCase)
            && Model.SortDir.Equals("asc", StringComparison.OrdinalIgnoreCase)
            ? "desc"
            : "asc";
    }

    string SortIcon(string field)
    {
        if (!Model.SortField.Equals(field, StringComparison.OrdinalIgnoreCase))
        {
            return "↕";
        }

        return Model.SortDir.Equals("asc", StringComparison.OrdinalIgnoreCase) ? "↑" : "↓";
    }
}

<h1 class="mb-3">Elenco Dipendenti (Demo GraphQL)</h1>

<div class="mb-3">
    <a class="btn btn-primary"
       asp-controller="Employees"
       asp-action="Create"
       asp-route-page="@Model.Page"
       asp-route-pageSize="@Model.PageSize"
       asp-route-sortField="@Model.SortField"
       asp-route-sortDir="@Model.SortDir">Add Employee</a>
    <a class="btn btn-outline-secondary"
       asp-controller="Reviews"
       asp-action="Index">Vai alle Review</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <strong>Errore:</strong> @Model.ErrorMessage
    </div>
}

<form method="get" asp-controller="Employees" asp-action="Index" class="row g-3 mb-4">
    <div class="col-md-2">
        <label class="form-label" for="page">Page</label>
        <input class="form-control" type="number" id="page" name="page" min="1" value="@Model.Page" />
    </div>
    <div class="col-md-2">
        <label class="form-label" for="pageSize">Page Size</label>
        <select class="form-select" id="pageSize" name="pageSize">
            @{
                var allowedPageSizes = new[] { 5, 10, 20, 50 };
                foreach (var size in allowedPageSizes)
                {
                    if (Model.PageSize == size)
                    {
                        <option selected value="@size">@size</option>
                    }
                    else
                    {
                        <option value="@size">@size</option>
                    }
                }
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label" for="sortField">Sort Field</label>
        <select class="form-select" id="sortField" name="sortField">
            @{
                var sortFields = new[] { "id", "firstName", "lastName", "email" };
                foreach (var field in sortFields)
                {
                    if (Model.SortField.Equals(field, StringComparison.OrdinalIgnoreCase))
                    {
                        <option selected value="@field">@field</option>
                    }
                    else
                    {
                        <option value="@field">@field</option>
                    }
                }
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label" for="sortDir">Sort Dir</label>
        <select class="form-select" id="sortDir" name="sortDir">
            @if (Model.SortDir.Equals("asc", StringComparison.OrdinalIgnoreCase))
            {
                <option selected value="asc">asc</option>
                <option value="desc">desc</option>
            }
            else
            {
                <option value="asc">asc</option>
                <option selected value="desc">desc</option>
            }
        </select>
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <button type="submit" class="btn btn-primary">Applica</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>
                    <a asp-controller="Employees"
                       asp-action="Index"
                       asp-route-page="1"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-sortField="id"
                       asp-route-sortDir="@ToggleSortDir("id")">
                        Id @SortIcon("id")
                    </a>
                </th>
                <th>
                    <a asp-controller="Employees"
                       asp-action="Index"
                       asp-route-page="1"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-sortField="firstName"
                       asp-route-sortDir="@ToggleSortDir("firstName")">
                        FirstName @SortIcon("firstName")
                    </a>
                </th>
                <th>
                    <a asp-controller="Employees"
                       asp-action="Index"
                       asp-route-page="1"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-sortField="lastName"
                       asp-route-sortDir="@ToggleSortDir("lastName")">
                        LastName @SortIcon("lastName")
                    </a>
                </th>
                <th>
                    <a asp-controller="Employees"
                       asp-action="Index"
                       asp-route-page="1"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-sortField="email"
                       asp-route-sortDir="@ToggleSortDir("email")">
                        Email @SortIcon("email")
                    </a>
                </th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="5" class="text-center">Nessun dato disponibile.</td>
                </tr>
            }
            else
            {
                @foreach (var employee in Model.Items)
                {
                    <tr>
                        <td>@employee.Id</td>
                        <td>@employee.FirstName</td>
                        <td>@employee.LastName</td>
                        <td>@employee.Email</td>
                        <td>
                            <div class="employee-actions">
                                <a class="btn btn-sm employee-action-edit"
                                   asp-controller="Employees"
                                   asp-action="Edit"
                                   asp-route-id="@employee.Id"
                                   asp-route-page="@Model.Page"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-sortField="@Model.SortField"
                                   asp-route-sortDir="@Model.SortDir">Edit</a>
                                <a class="btn btn-sm employee-action-delete"
                                   asp-controller="Employees"
                                   asp-action="Delete"
                                   asp-route-id="@employee.Id"
                                   asp-route-page="@Model.Page"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-sortField="@Model.SortField"
                                   asp-route-sortDir="@Model.SortDir">Delete</a>
                                <a class="btn btn-sm btn-outline-secondary"
                                   asp-controller="Reviews"
                                   asp-action="Index"
                                   asp-route-employeeId="@employee.Id">Reviews</a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="d-flex justify-content-between align-items-center mt-3">
    <div>
        <strong>Page:</strong> @Model.PageInfo.Page
        <span class="mx-2">|</span>
        <strong>Total Pages:</strong> @Model.PageInfo.TotalPages
        <span class="mx-2">|</span>
        <strong>Total Count:</strong> @Model.PageInfo.TotalCount
    </div>
    <nav aria-label="Employees pagination">
        <ul class="pagination mb-0">
            <li class="page-item @(currentPage > 1 ? string.Empty : "disabled")">
                @if (currentPage > 1)
                {
                    <a class="page-link"
                       asp-controller="Employees"
                       asp-action="Index"
                       asp-route-page="1"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-sortField="@Model.SortField"
                       asp-route-sortDir="@Model.SortDir">First</a>
                }
                else
                {
                    <span class="page-link">First</span>
                }
            </li>

            <li class="page-item @(Model.PageInfo.HasPreviousPage ? string.Empty : "disabled")">
                @if (Model.PageInfo.HasPreviousPage)
                {
                    <a class="page-link"
                       asp-controller="Employees"
                       asp-action="Index"
                       asp-route-page="@(currentPage - 1)"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-sortField="@Model.SortField"
                       asp-route-sortDir="@Model.SortDir">Previous</a>
                }
                else
                {
                    <span class="page-link">Previous</span>
                }
            </li>

            @if (totalPages <= 1)
            {
                <li class="page-item active" aria-current="page">
                    <span class="page-link">1</span>
                </li>
            }
            else
            {
                <li class="page-item @(currentPage == 1 ? "active" : string.Empty)" aria-current="@(currentPage == 1 ? "page" : null)">
                    @if (currentPage == 1)
                    {
                        <span class="page-link">1</span>
                    }
                    else
                    {
                        <a class="page-link"
                           asp-controller="Employees"
                           asp-action="Index"
                           asp-route-page="1"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-sortField="@Model.SortField"
                           asp-route-sortDir="@Model.SortDir">1</a>
                    }
                </li>

                @if (startPage > 2)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }

                @for (var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
                {
                    if (pageNumber == 1 || pageNumber == totalPages)
                    {
                        continue;
                    }

                    <li class="page-item @(currentPage == pageNumber ? "active" : string.Empty)" aria-current="@(currentPage == pageNumber ? "page" : null)">
                        @if (currentPage == pageNumber)
                        {
                            <span class="page-link">@pageNumber</span>
                        }
                        else
                        {
                            <a class="page-link"
                               asp-controller="Employees"
                               asp-action="Index"
                               asp-route-page="@pageNumber"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-sortField="@Model.SortField"
                               asp-route-sortDir="@Model.SortDir">@pageNumber</a>
                        }
                    </li>
                }

                @if (endPage < totalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }

                <li class="page-item @(currentPage == totalPages ? "active" : string.Empty)" aria-current="@(currentPage == totalPages ? "page" : null)">
                    @if (currentPage == totalPages)
                    {
                        <span class="page-link">@totalPages</span>
                    }
                    else
                    {
                        <a class="page-link"
                           asp-controller="Employees"
                           asp-action="Index"
                           asp-route-page="@totalPages"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-sortField="@Model.SortField"
                           asp-route-sortDir="@Model.SortDir">@totalPages</a>
                    }
                </li>
            }

            <li class="page-item @(Model.PageInfo.HasNextPage ? string.Empty : "disabled")">
                @if (Model.PageInfo.HasNextPage)
                {
                    <a class="page-link"
                       asp-controller="Employees"
                       asp-action="Index"
                       asp-route-page="@(currentPage + 1)"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-sortField="@Model.SortField"
                       asp-route-sortDir="@Model.SortDir">Next</a>
                }
                else
                {
                    <span class="page-link">Next</span>
                }
            </li>

            <li class="page-item @(currentPage < totalPages ? string.Empty : "disabled")">
                @if (currentPage < totalPages)
                {
                    <a class="page-link"
                       asp-controller="Employees"
                       asp-action="Index"
                       asp-route-page="@totalPages"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-sortField="@Model.SortField"
                       asp-route-sortDir="@Model.SortDir">Last</a>
                }
                else
                {
                    <span class="page-link">Last</span>
                }
            </li>
        </ul>
    </nav>
</div>
