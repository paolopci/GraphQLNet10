{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../../../..",
          "files": [
            "EmployeeManagementGraphQL/EmployeeManagementGraphQL.csproj",
            "EmployeeManagementGraphQL.Mvc/EmployeeManagementGraphQL.Mvc.csproj"
          ]
        }
      ],
      "dest": "api",
      "disableGitFeatures": true,
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "docs/**/*.md",
          "toc.yml",
          "api/**.yml",
          "api/**/toc.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "docs/**/*.png",
          "docs/**/*.jpg",
          "docs/**/*.svg",
          "static/**/*.css",
          "artifacts/openapi/**/*.json"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "modern",
      "default"
    ],
    "globalMetadata": {
      "_appTitle": "Technical Documentation",
      "_appName": "Docs Multi-Stack",
      "_appFooter": "Generated by dotnet-angular-blazor-docs skill",
      "_enableSearch": true,
      "pdf": false
    }
  }
}
